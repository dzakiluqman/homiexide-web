---
export const prerender = false;
import Layout from '../layouts/Layout.astro';
import TrackPlayer from '../components/TrackPlayer.astro';
import LyricsPanel from '../components/LyricsPanel.astro';
import { supabase } from '../lib/supabase';

// Mengambil data tracks beserta author-nya
const { data: tracks, error: trackError } = await supabase
  .from('tracks')
  .select(`
    id,
    title,
    cover,
    file,
    lyrics,
    track_authors (
      talents (
        display_name
      )
    )
  `)
  .order('id', { ascending: false });

// Mengambil data talents
const { data: talents, error: talentError } = await supabase
  .from('talents')
  .select('id, display_name, profile_picture')
  .order('display_name', { ascending: true });

if (trackError || talentError) {
  console.error('Error fetching data:', trackError || talentError);
}
---

<Layout title="Homiexide - Young Boys Records">
    <main class="relative z-10 max-w-[1200px] mx-auto px-8 pt-20 pb-32">
        <div class="grid grid-cols-1 lg:grid-cols-[1fr_320px] gap-16">
            
            <div class="flex flex-col">
                <h1 class="text-4xl md:text-5xl font-black mb-10 tracking-tight">
                    Young Boys Records
                </h1>
                
                <div class="flex flex-col md:flex-row gap-8 mb-16">
                    <img 
                        src="/ybr-logo.png" 
                        alt="YBR Logo" 
                        class="w-48 h-48 shrink-0 rounded-xl object-contain" 
                    />
                    
                    <div class="text-[14px] text-gray-300 leading-relaxed font-medium space-y-5">
                        <p>
                            A independent music label existing within GTA San Andreas Multiplayer Roleplay 
                            as an In Character (IC) entity, serving as a creative platform for characters 
                            to express themselves through music such as hip-hop, R&B, and other evolving 
                            genres within the roleplay scene.
                        </p>
                        <p>
                            The channel features music releases, roleplay-driven storytelling, collaborations, 
                            and behind-the-scenes moments that reflect the journey, struggles, and ambitions 
                            of virtual artists, making it not just entertainment but a dynamic representation 
                            of a living, character-driven music industry.
                        </p>
                    </div>
                </div>

                <div>
                    <h2 class="text-2xl font-bold mb-8 tracking-wide text-white">
                        Most trending tracks
                    </h2>

                    <div class="flex flex-col gap-2">
                        {tracks && tracks.length > 0 ? (
                            tracks.map(track => {
                                const authors = track.track_authors
                                    .map((a: any) => a.talents.display_name)
                                    .join(', ');

                                return (
                                    <TrackPlayer 
                                        title={track.title}
                                        author={authors}
                                        cover={track.cover}
                                        audioUrl={track.file}
                                        lyrics={track.lyrics}
                                    />
                                );
                            })
                        ) : (
                            <p class="text-gray-500 italic">
                                No tracks available yet.
                            </p>
                        )}
                    </div>
                </div>
            </div>

            <!-- Sidebar: Unified Container for Talents and Lyrics Panel -->
            <aside class="w-full">
                <div class="sticky top-32 w-full">
                    <div 
                        id="sidebar-card" 
                        class="relative w-full min-h-[460px] max-h-[calc(100vh-160px)] flex flex-col border border-white/5 bg-[#111111]/50 backdrop-blur-xl rounded-3xl overflow-hidden shadow-2xl transition-all duration-300"
                    >
                        <!-- Talents Card View -->
                        <div 
                            id="talents-card" 
                            class="flex-1 flex flex-col p-8 transition-all duration-300 ease-in-out opacity-100 translate-y-0"
                        >
                            <div class="flex items-center justify-between mb-6">
                                <h2 class="text-xl font-bold tracking-wide text-white">
                                    Talents
                                </h2>
                                {talents && talents.length > 0 && (
                                    <span class="text-xs font-semibold px-2.5 py-1 rounded-full bg-white/5 text-gray-400 border border-white/5">
                                        {talents.length}
                                    </span>
                                )}
                            </div>
                            
                            <div class="flex-1 overflow-y-auto pr-1 -mr-1 custom-scrollbar min-h-0">
                                <ul class="flex flex-col gap-4">
                                    {talents && talents.length > 0 ? (
                                        talents.map(talent => (
                                            <li>
                                                <a 
                                                    href={`/talents/${talent.id}`} 
                                                    class="flex items-center gap-4 group cursor-pointer p-2 -ml-2 rounded-xl hover:bg-white/5 transition-all"
                                                >
                                                    <img 
                                                        src={talent.profile_picture || 'https://placehold.co/100x100/333/666?text=?'} 
                                                        alt={talent.display_name} 
                                                        class="w-10 h-10 rounded-full object-cover border border-white/10 group-hover:border-white/30 transition-all" 
                                                    />
                                                    <span class="text-[15px] font-semibold text-gray-400 group-hover:text-white transition-colors">
                                                        {talent.display_name}
                                                    </span>
                                                </a>
                                            </li>
                                        ))
                                    ) : (
                                        <p class="text-gray-500 text-sm italic">
                                            Searching for talents...
                                        </p>
                                    )}
                                </ul>
                            </div>
                        </div>

                        <!-- Lyrics Panel (Overlays cleanly in the exact same footprint) -->
                        <LyricsPanel />
                    </div>
                </div>
            </aside>

        </div>
    </main>
</Layout>